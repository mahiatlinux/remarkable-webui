{
	"name": "remarkable-webui",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch server/index.ts\" \"vite dev\"",
		"build": "vite build && node tools/licenses.mjs dist/third-party.txt",
		"start": "NODE_ENV=production tsx server/index.ts",
		"preview": "vite preview",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
		"test": "tsx --test tests/*.test.ts",
		"test:ui": "playwright test",
		"desktop:prepare": "node tools/prepare-desktop.mjs",
		"desktop:dev": "tauri dev",
		"desktop:build": "tauri build"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@tauri-apps/cli": "^2.11.4",
		"@types/archiver": "^8.0.0",
		"@types/busboy": "^1.5.4",
		"@types/express": "^5.0.6",
		"@types/node": "^22.0.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@types/ssh2": "^1.15.5",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^6.1.1",
		"concurrently": "^10.0.5",
		"esbuild": "^0.28.2",
		"prettier": "^3.7.4",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/manrope": "^5.3.0",
		"@tailwindcss/vite": "^4.2.2",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.3",
		"@tauri-apps/plugin-fs": "^2.5.2",
		"@tauri-apps/plugin-opener": "^2.5.5",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"archiver": "^8.0.0",
		"busboy": "^1.6.0",
		"express": "^5.2.1",
		"fix-webm-duration": "^1.0.6",
		"pdfjs-dist": "^6.2.108",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-router-dom": "^7.9.0",
		"sonner": "^2.0.7",
		"ssh2": "^1.17.0",
		"tailwindcss": "^4.2.2",
		"tippy.js": "^6.3.7",
		"tsx": "^4.23.13",
		"ws": "^8.21.3"
	}
}
