		"@types/react-dom": "^19.2.0",
		"@types/ssh2": "^1.15.5",
		"@types/ws": "^8.18.1",
		"@types/yauzl": "^3.4.0",
		"@vitejs/plugin-react": "^6.1.1",
		"concurrently": "^10.0.5",
		"prettier": "^3.7.4",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.2.2",
		"@xterm/addon-fit": "^0.11.0",
